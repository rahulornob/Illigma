{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahulornob/Illigma/packages/format/schema/node.v0.schema.json",
  "title": "Illigma node, format version 0",
  "type": "object",
  "required": [
    "id", "type", "parentId", "index", "name", "visible", "locked",
    "x", "y", "width", "height", "rotation", "opacity",
    "fills", "strokes", "strokeWeight", "cornerRadius"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Also names the page file for pages" },
    "type": {
      "enum": ["PAGE", "SECTION", "FRAME", "GROUP", "RECTANGLE", "ELLIPSE", "LINE", "POLYGON", "STAR", "VECTOR", "TEXT", "COMPONENT", "COMPONENT_SET", "INSTANCE"]
    },
    "parentId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "null only for pages" },
    "index": { "type": "string", "pattern": "^(?!A00000000000000000000000000$)(?:a[0-9A-Za-z]{1}|b[0-9A-Za-z]{2}|c[0-9A-Za-z]{3}|d[0-9A-Za-z]{4}|e[0-9A-Za-z]{5}|f[0-9A-Za-z]{6}|g[0-9A-Za-z]{7}|h[0-9A-Za-z]{8}|i[0-9A-Za-z]{9}|j[0-9A-Za-z]{10}|k[0-9A-Za-z]{11}|l[0-9A-Za-z]{12}|m[0-9A-Za-z]{13}|n[0-9A-Za-z]{14}|o[0-9A-Za-z]{15}|p[0-9A-Za-z]{16}|q[0-9A-Za-z]{17}|r[0-9A-Za-z]{18}|s[0-9A-Za-z]{19}|t[0-9A-Za-z]{20}|u[0-9A-Za-z]{21}|v[0-9A-Za-z]{22}|w[0-9A-Za-z]{23}|x[0-9A-Za-z]{24}|y[0-9A-Za-z]{25}|z[0-9A-Za-z]{26}|Z[0-9A-Za-z]{1}|Y[0-9A-Za-z]{2}|X[0-9A-Za-z]{3}|W[0-9A-Za-z]{4}|V[0-9A-Za-z]{5}|U[0-9A-Za-z]{6}|T[0-9A-Za-z]{7}|S[0-9A-Za-z]{8}|R[0-9A-Za-z]{9}|Q[0-9A-Za-z]{10}|P[0-9A-Za-z]{11}|O[0-9A-Za-z]{12}|N[0-9A-Za-z]{13}|M[0-9A-Za-z]{14}|L[0-9A-Za-z]{15}|K[0-9A-Za-z]{16}|J[0-9A-Za-z]{17}|I[0-9A-Za-z]{18}|H[0-9A-Za-z]{19}|G[0-9A-Za-z]{20}|F[0-9A-Za-z]{21}|E[0-9A-Za-z]{22}|D[0-9A-Za-z]{23}|C[0-9A-Za-z]{24}|B[0-9A-Za-z]{25}|A[0-9A-Za-z]{26})(?:[0-9A-Za-z]*[1-9A-Za-z])?$", "description": "Fractional index among siblings; compare as plain strings" },
    "name": { "type": "string" },
    "visible": { "type": "boolean" },
    "locked": { "type": "boolean" },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "width": { "type": "number" },
    "height": { "type": "number" },
    "rotation": { "type": "number", "description": "Degrees, clockwise" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "fills": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
    "strokes": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
    "strokeWeight": { "type": "number" },
    "cornerRadius": { "type": "number" },
    "characters": { "type": "string" },
    "fontFamily": { "type": "string" },
    "fontStyle": { "type": "string" },
    "fontSize": { "type": "number" },
    "lineHeight": {
      "oneOf": [
        { "type": "number", "description": "Pixels (format 0)" },
        { "type": "object", "required": ["unit"], "additionalProperties": false, "properties": { "unit": { "const": "AUTO" } } },
        { "type": "object", "required": ["value", "unit"], "additionalProperties": false, "properties": { "value": { "type": "number", "minimum": 0, "maximum": 10000 }, "unit": { "enum": ["PIXELS", "PERCENT"] } } }
      ],
      "description": "Line height: pixels, a percentage of the font size, or the font's own (AUTO). Default AUTO"
    },
    "letterSpacing": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": { "value": { "type": "number", "minimum": -10000, "maximum": 10000 }, "unit": { "enum": ["PIXELS", "PERCENT"] } },
      "description": "Space between letters: pixels or a percentage of the font size. Default 0"
    },
    "textAutoResize": { "enum": ["NONE", "WIDTH_AND_HEIGHT", "HEIGHT", "TRUNCATE"], "description": "How the box follows the text: auto width, auto height, fixed, or fixed with an ellipsis. Absent means NONE (format 0 wrapped text at its width)" },
    "textAlignHorizontal": { "enum": ["LEFT", "CENTER", "RIGHT", "JUSTIFIED"], "description": "Default LEFT" },
    "textAlignVertical": { "enum": ["TOP", "CENTER", "BOTTOM"], "description": "Default TOP" },
    "layoutMode": { "enum": ["NONE", "HORIZONTAL", "VERTICAL"], "description": "Auto layout direction. Default NONE" },
    "itemSpacing": { "type": "number", "description": "Gap between children along the stack; may be negative. Default 0" },
    "counterAxisSpacing": { "type": "number", "minimum": 0, "description": "Gap between wrapped rows or columns. Default: itemSpacing, never negative" },
    "paddingLeft": { "type": "number", "minimum": 0, "description": "Default 0" },
    "paddingRight": { "type": "number", "minimum": 0, "description": "Default 0" },
    "paddingTop": { "type": "number", "minimum": 0, "description": "Default 0" },
    "paddingBottom": { "type": "number", "minimum": 0, "description": "Default 0" },
    "primaryAxisAlignItems": { "enum": ["MIN", "CENTER", "MAX", "SPACE_BETWEEN", "SPACE_AROUND", "SPACE_EVENLY"], "description": "Default MIN" },
    "counterAxisAlignItems": { "enum": ["MIN", "CENTER", "MAX"], "description": "Default MIN" },
    "counterAxisAlignContent": { "enum": ["AUTO", "SPACE_BETWEEN"], "description": "Wrapped frames only. Default AUTO" },
    "primaryAxisSizingMode": { "enum": ["FIXED", "AUTO"], "description": "AUTO hugs the content. Default AUTO" },
    "counterAxisSizingMode": { "enum": ["FIXED", "AUTO"], "description": "AUTO hugs the content. Default AUTO" },
    "layoutWrap": { "enum": ["NO_WRAP", "WRAP"], "description": "Default NO_WRAP" },
    "layoutPositioning": { "enum": ["AUTO", "ABSOLUTE"], "description": "ABSOLUTE = ignore the parent's auto layout. Default AUTO" },
    "layoutSizingHorizontal": { "$ref": "#/$defs/layoutSizing" },
    "layoutSizingVertical": { "$ref": "#/$defs/layoutSizing" },
    "constraints": {
      "type": "object",
      "required": ["horizontal", "vertical"],
      "additionalProperties": false,
      "properties": {
        "horizontal": { "$ref": "#/$defs/constraintType" },
        "vertical": { "$ref": "#/$defs/constraintType" }
      },
      "description": "How the node follows its parent frame when that frame is resized. Default MIN and MIN (left and top)"
    },
    "minWidth": { "type": "number", "minimum": 0 },
    "maxWidth": { "type": "number", "minimum": 0 },
    "minHeight": { "type": "number", "minimum": 0 },
    "maxHeight": { "type": "number", "minimum": 0 },
    "vectorNetwork": { "$ref": "#/$defs/vectorNetwork" },
    "pointCount": { "type": "integer", "minimum": 3, "maximum": 1000, "description": "POLYGON sides or STAR points. Default 3 (polygon) or 5 (star)" },
    "innerRadius": { "$ref": "#/$defs/unit", "description": "STAR inner points' distance from the centre as a fraction of the outer. Default 0.382" },
    "strokeCap": { "enum": ["NONE", "ROUND", "SQUARE"], "description": "Ends of open paths and lines. Default NONE" },
    "strokeJoin": { "enum": ["MITER", "BEVEL", "ROUND"], "description": "Corners of strokes. Default MITER" },
    "effects": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/effect" }, "description": "Shadows and blurs, bottom first. Default none" },
    "blendMode": { "$ref": "#/$defs/blendMode", "description": "How the layer mixes with what is under it. Default PASS_THROUGH" },
    "strokeAlign": { "enum": ["CENTER", "INSIDE", "OUTSIDE"], "description": "Where strokes sit on the outline. Absent means CENTER (format 0 drew every stroke centred); lines and open paths are always centred" },
    "exportSettings": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/exportSettings" }, "description": "The files this layer or page exports to (Figma's ExportSettings), in order. Default none" }
  },
  "$defs": {
    "exportSettings": {
      "type": "object",
      "required": ["format"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["PNG", "JPG"] },
            "suffix": { "type": "string", "maxLength": 200, "description": "Added before the extension, e.g. @2x. Default empty" },
            "contentsOnly": { "type": "boolean", "description": "Default true" },
            "useAbsoluteBounds": { "type": "boolean", "description": "Default false" },
            "constraint": {
              "type": "object",
              "required": ["type", "value"],
              "additionalProperties": false,
              "properties": { "type": { "enum": ["SCALE", "WIDTH", "HEIGHT"] }, "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000, "description": "SCALE at most 100; WIDTH and HEIGHT in pixels" } },
              "description": "Default SCALE 1"
            },
            "quality": { "type": "number", "minimum": 0, "maximum": 100, "description": "JPG only. Default 90" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "format": { "const": "SVG" },
            "suffix": { "type": "string", "maxLength": 200 },
            "contentsOnly": { "type": "boolean" },
            "useAbsoluteBounds": { "type": "boolean" },
            "svgOutlineText": { "type": "boolean", "description": "Default false" },
            "svgIdAttribute": { "type": "boolean", "description": "Default false" },
            "svgSimplifyStroke": { "type": "boolean", "description": "Default true" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "format": { "const": "PDF" },
            "suffix": { "type": "string", "maxLength": 200 },
            "contentsOnly": { "type": "boolean" },
            "useAbsoluteBounds": { "type": "boolean" }
          }
        }
      ]
    },
    "layoutSizing": { "enum": ["FIXED", "HUG", "FILL"], "description": "Default: HUG on an auto layout frame's AUTO axes, else FIXED" },
    "constraintType": { "enum": ["MIN", "CENTER", "MAX", "STRETCH", "SCALE"] },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "vector2": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "vectorNetwork": {
      "type": "object",
      "description": "VECTOR outline in the node's own space (0..width, 0..height), as Figma's vector network. Each region loop must list segments that join end to end and close (checked by the reader, not this schema)",
      "required": ["vertices", "segments", "regions"],
      "additionalProperties": false,
      "properties": {
        "vertices": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "cornerRadius": { "type": "number", "minimum": 0 } }
          }
        },
        "segments": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": ["start", "end", "tangentStart", "tangentEnd"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "integer", "minimum": 0, "description": "Vertex index" },
              "end": { "type": "integer", "minimum": 0, "description": "Vertex index" },
              "tangentStart": { "$ref": "#/$defs/vector2", "description": "Bezier handle, relative to the start vertex" },
              "tangentEnd": { "$ref": "#/$defs/vector2", "description": "Bezier handle, relative to the end vertex" }
            }
          }
        },
        "regions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": ["windingRule", "loops"],
            "additionalProperties": false,
            "properties": {
              "windingRule": { "enum": ["NONZERO", "EVENODD"] },
              "loops": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "description": "Segment index" } } }
            }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "$ref": "#/$defs/unit" },
        "g": { "$ref": "#/$defs/unit" },
        "b": { "$ref": "#/$defs/unit" },
        "a": { "$ref": "#/$defs/unit" }
      }
    },
    "blendMode": {
      "enum": [
        "PASS_THROUGH", "NORMAL", "DARKEN", "MULTIPLY", "LINEAR_BURN", "COLOR_BURN", "LIGHTEN", "SCREEN", "LINEAR_DODGE", "COLOR_DODGE",
        "OVERLAY", "SOFT_LIGHT", "HARD_LIGHT", "DIFFERENCE", "EXCLUSION", "HUE", "SATURATION", "COLOR", "LUMINOSITY"
      ]
    },
    "transform": {
      "type": "array",
      "description": "Affine 2 x 3 matrix [[a, c, e], [b, d, f]], as in Figma",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
    },
    "effectRadius": { "type": "number", "minimum": 0, "maximum": 1000 },
    "paint": {
      "type": "object",
      "required": ["type", "visible"],
      "properties": {
        "type": { "enum": ["SOLID", "GRADIENT_LINEAR", "GRADIENT_RADIAL", "GRADIENT_ANGULAR", "GRADIENT_DIAMOND", "IMAGE"] },
        "visible": { "type": "boolean" },
        "opacity": { "$ref": "#/$defs/unit", "description": "Default 1" },
        "blendMode": { "$ref": "#/$defs/blendMode", "description": "Default NORMAL" }
      },
      "oneOf": [
        {
          "required": ["color"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "SOLID" },
            "visible": true,
            "opacity": true,
            "blendMode": true,
            "color": { "$ref": "#/$defs/color" }
          }
        },
        {
          "required": ["gradientStops", "gradientTransform"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["GRADIENT_LINEAR", "GRADIENT_RADIAL", "GRADIENT_ANGULAR", "GRADIENT_DIAMOND"] },
            "visible": true,
            "opacity": true,
            "blendMode": true,
            "gradientStops": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": ["position", "color"],
                "additionalProperties": false,
                "properties": { "position": { "$ref": "#/$defs/unit" }, "color": { "$ref": "#/$defs/color" } }
              }
            },
            "gradientTransform": {
              "$ref": "#/$defs/transform",
              "description": "Maps the node's box, normalised to 0..1, into gradient space: linear runs from (0, 0.5) to (1, 0.5); radial, angular and diamond are centred on (0.5, 0.5)"
            }
          }
        },
        {
          "required": ["imageHash", "scaleMode"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "IMAGE" },
            "visible": true,
            "opacity": true,
            "blendMode": true,
            "imageHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the image file, stored as images/<hash>.<ext>" },
            "scaleMode": { "enum": ["FILL", "FIT", "CROP", "TILE"] },
            "imageTransform": { "$ref": "#/$defs/transform", "description": "CROP only: maps the node's box, normalised to 0..1, into the image, also normalised" },
            "scalingFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000, "description": "TILE only: tile size as a multiple of the image's size. Default 1" }
          }
        }
      ]
    },
    "effect": {
      "type": "object",
      "required": ["type", "visible", "radius"],
      "oneOf": [
        {
          "required": ["color", "offset"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["DROP_SHADOW", "INNER_SHADOW"] },
            "visible": { "type": "boolean" },
            "color": { "$ref": "#/$defs/color" },
            "offset": {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "properties": { "x": { "type": "number", "minimum": -1000, "maximum": 1000 }, "y": { "type": "number", "minimum": -1000, "maximum": 1000 } }
            },
            "radius": { "$ref": "#/$defs/effectRadius", "description": "Blur radius (CSS box-shadow blur)" },
            "spread": { "type": "number", "minimum": -1000, "maximum": 1000, "description": "Default 0" },
            "blendMode": { "$ref": "#/$defs/blendMode", "description": "Default NORMAL" },
            "showShadowBehindNode": { "type": "boolean", "description": "DROP_SHADOW only. Default false" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["LAYER_BLUR", "BACKGROUND_BLUR"] },
            "visible": { "type": "boolean" },
            "radius": { "$ref": "#/$defs/effectRadius" }
          }
        }
      ]
    }
  }
}
