{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahulornob/Illigma/packages/format/schema/node.v0.schema.json",
  "title": "Illigma node, format version 0",
  "type": "object",
  "required": [
    "id", "type", "parentId", "index", "name", "visible", "locked",
    "x", "y", "width", "height", "rotation", "opacity",
    "fills", "strokes", "strokeWeight", "cornerRadius"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Also names the page file for pages" },
    "type": {
      "enum": ["PAGE", "SECTION", "FRAME", "GROUP", "RECTANGLE", "ELLIPSE", "LINE", "POLYGON", "STAR", "VECTOR", "TEXT", "COMPONENT", "COMPONENT_SET", "INSTANCE"]
    },
    "parentId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "null only for pages" },
    "index": { "type": "string", "pattern": "^(?!A00000000000000000000000000$)(?:a[0-9A-Za-z]{1}|b[0-9A-Za-z]{2}|c[0-9A-Za-z]{3}|d[0-9A-Za-z]{4}|e[0-9A-Za-z]{5}|f[0-9A-Za-z]{6}|g[0-9A-Za-z]{7}|h[0-9A-Za-z]{8}|i[0-9A-Za-z]{9}|j[0-9A-Za-z]{10}|k[0-9A-Za-z]{11}|l[0-9A-Za-z]{12}|m[0-9A-Za-z]{13}|n[0-9A-Za-z]{14}|o[0-9A-Za-z]{15}|p[0-9A-Za-z]{16}|q[0-9A-Za-z]{17}|r[0-9A-Za-z]{18}|s[0-9A-Za-z]{19}|t[0-9A-Za-z]{20}|u[0-9A-Za-z]{21}|v[0-9A-Za-z]{22}|w[0-9A-Za-z]{23}|x[0-9A-Za-z]{24}|y[0-9A-Za-z]{25}|z[0-9A-Za-z]{26}|Z[0-9A-Za-z]{1}|Y[0-9A-Za-z]{2}|X[0-9A-Za-z]{3}|W[0-9A-Za-z]{4}|V[0-9A-Za-z]{5}|U[0-9A-Za-z]{6}|T[0-9A-Za-z]{7}|S[0-9A-Za-z]{8}|R[0-9A-Za-z]{9}|Q[0-9A-Za-z]{10}|P[0-9A-Za-z]{11}|O[0-9A-Za-z]{12}|N[0-9A-Za-z]{13}|M[0-9A-Za-z]{14}|L[0-9A-Za-z]{15}|K[0-9A-Za-z]{16}|J[0-9A-Za-z]{17}|I[0-9A-Za-z]{18}|H[0-9A-Za-z]{19}|G[0-9A-Za-z]{20}|F[0-9A-Za-z]{21}|E[0-9A-Za-z]{22}|D[0-9A-Za-z]{23}|C[0-9A-Za-z]{24}|B[0-9A-Za-z]{25}|A[0-9A-Za-z]{26})(?:[0-9A-Za-z]*[1-9A-Za-z])?$", "description": "Fractional index among siblings; compare as plain strings" },
    "name": { "type": "string" },
    "visible": { "type": "boolean" },
    "locked": { "type": "boolean" },
    "x": { "type": "number" },
    "y": { "type": "number" },
    "width": { "type": "number" },
    "height": { "type": "number" },
    "rotation": { "type": "number", "description": "Degrees, clockwise" },
    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
    "fills": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
    "strokes": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
    "strokeWeight": { "type": "number" },
    "cornerRadius": { "type": "number" },
    "characters": { "type": "string" },
    "fontFamily": { "type": "string" },
    "fontStyle": { "type": "string" },
    "fontSize": { "type": "number" },
    "lineHeight": { "type": "number" },
    "layoutMode": { "enum": ["NONE", "HORIZONTAL", "VERTICAL"], "description": "Auto layout direction. Default NONE" },
    "itemSpacing": { "type": "number", "description": "Gap between children along the stack; may be negative. Default 0" },
    "counterAxisSpacing": { "type": "number", "minimum": 0, "description": "Gap between wrapped rows or columns. Default: itemSpacing, never negative" },
    "paddingLeft": { "type": "number", "minimum": 0, "description": "Default 0" },
    "paddingRight": { "type": "number", "minimum": 0, "description": "Default 0" },
    "paddingTop": { "type": "number", "minimum": 0, "description": "Default 0" },
    "paddingBottom": { "type": "number", "minimum": 0, "description": "Default 0" },
    "primaryAxisAlignItems": { "enum": ["MIN", "CENTER", "MAX", "SPACE_BETWEEN", "SPACE_AROUND", "SPACE_EVENLY"], "description": "Default MIN" },
    "counterAxisAlignItems": { "enum": ["MIN", "CENTER", "MAX"], "description": "Default MIN" },
    "counterAxisAlignContent": { "enum": ["AUTO", "SPACE_BETWEEN"], "description": "Wrapped frames only. Default AUTO" },
    "primaryAxisSizingMode": { "enum": ["FIXED", "AUTO"], "description": "AUTO hugs the content. Default AUTO" },
    "counterAxisSizingMode": { "enum": ["FIXED", "AUTO"], "description": "AUTO hugs the content. Default AUTO" },
    "layoutWrap": { "enum": ["NO_WRAP", "WRAP"], "description": "Default NO_WRAP" },
    "layoutPositioning": { "enum": ["AUTO", "ABSOLUTE"], "description": "ABSOLUTE = ignore the parent's auto layout. Default AUTO" },
    "layoutSizingHorizontal": { "$ref": "#/$defs/layoutSizing" },
    "layoutSizingVertical": { "$ref": "#/$defs/layoutSizing" },
    "constraints": {
      "type": "object",
      "required": ["horizontal", "vertical"],
      "additionalProperties": false,
      "properties": {
        "horizontal": { "$ref": "#/$defs/constraintType" },
        "vertical": { "$ref": "#/$defs/constraintType" }
      },
      "description": "How the node follows its parent frame when that frame is resized. Default MIN and MIN (left and top)"
    },
    "minWidth": { "type": "number", "minimum": 0 },
    "maxWidth": { "type": "number", "minimum": 0 },
    "minHeight": { "type": "number", "minimum": 0 },
    "maxHeight": { "type": "number", "minimum": 0 },
    "vectorNetwork": { "$ref": "#/$defs/vectorNetwork" },
    "pointCount": { "type": "integer", "minimum": 3, "maximum": 1000, "description": "POLYGON sides or STAR points. Default 3 (polygon) or 5 (star)" },
    "innerRadius": { "$ref": "#/$defs/unit", "description": "STAR inner points' distance from the centre as a fraction of the outer. Default 0.382" },
    "strokeCap": { "enum": ["NONE", "ROUND", "SQUARE"], "description": "Ends of open paths and lines. Default NONE" },
    "strokeJoin": { "enum": ["MITER", "BEVEL", "ROUND"], "description": "Corners of strokes. Default MITER" }
  },
  "$defs": {
    "layoutSizing": { "enum": ["FIXED", "HUG", "FILL"], "description": "Default: HUG on an auto layout frame's AUTO axes, else FIXED" },
    "constraintType": { "enum": ["MIN", "CENTER", "MAX", "STRETCH", "SCALE"] },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "vector2": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "vectorNetwork": {
      "type": "object",
      "description": "VECTOR outline in the node's own space (0..width, 0..height), as Figma's vector network. Each region loop must list segments that join end to end and close (checked by the reader, not this schema)",
      "required": ["vertices", "segments", "regions"],
      "additionalProperties": false,
      "properties": {
        "vertices": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "cornerRadius": { "type": "number", "minimum": 0 } }
          }
        },
        "segments": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": ["start", "end", "tangentStart", "tangentEnd"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "integer", "minimum": 0, "description": "Vertex index" },
              "end": { "type": "integer", "minimum": 0, "description": "Vertex index" },
              "tangentStart": { "$ref": "#/$defs/vector2", "description": "Bezier handle, relative to the start vertex" },
              "tangentEnd": { "$ref": "#/$defs/vector2", "description": "Bezier handle, relative to the end vertex" }
            }
          }
        },
        "regions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": ["windingRule", "loops"],
            "additionalProperties": false,
            "properties": {
              "windingRule": { "enum": ["NONZERO", "EVENODD"] },
              "loops": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "description": "Segment index" } } }
            }
          }
        }
      }
    },
    "paint": {
      "type": "object",
      "required": ["type", "color", "visible"],
      "properties": {
        "type": { "const": "SOLID" },
        "visible": { "type": "boolean" },
        "color": {
          "type": "object",
          "required": ["r", "g", "b", "a"],
          "properties": {
            "r": { "$ref": "#/$defs/unit" },
            "g": { "$ref": "#/$defs/unit" },
            "b": { "$ref": "#/$defs/unit" },
            "a": { "$ref": "#/$defs/unit" }
          }
        }
      }
    }
  }
}
